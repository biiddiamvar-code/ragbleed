---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allCases = await getCollection('cases');
const sorted = allCases.sort((a, b) => b.data.filed.localeCompare(a.data.filed));
---
<BaseLayout title="What's leaking from your RAG system?">
  <style>
    .hero{ padding:110px 32px 90px; max-width:900px; margin:0 auto; text-align:left; }
    .eyebrow{
      font-family:'IBM Plex Mono', monospace; font-size:11px;
      letter-spacing:.16em; text-transform:uppercase; color:var(--cyan);
    }
    .hero h1{
      font-family:'IBM Plex Mono', monospace; font-weight:700;
      font-size:clamp(32px,5.4vw,58px); line-height:1.08; letter-spacing:-.015em;
      margin:14px 0 26px;
    }
    .hero h1 em{ font-style:normal; color:var(--oxblood); }
    .hero p{ font-size:18px; color:var(--text-secondary); max-width:56ch; line-height:1.6; }

    .cases{ max-width:900px; margin:0 auto; padding:0 32px 100px; }
    .cases-head{
      display:flex; align-items:baseline; justify-content:space-between;
      margin-bottom:20px; border-bottom:1px solid var(--redact-border); padding-bottom:16px;
    }
    .cases-head h2{ font-family:'IBM Plex Mono', monospace; font-size:14px; letter-spacing:.12em; text-transform:uppercase; }
    .cases-head span{ font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--text-muted); }

    .case-row{
      display:grid; grid-template-columns:70px 100px 110px 1fr 24px;
      align-items:center; gap:18px; padding:22px 4px;
      border-bottom:1px solid var(--redact-border); cursor:pointer;
      transition:background 150ms ease; text-decoration:none;
    }
    .case-row:hover{ background:rgba(184,57,75,0.10); }
    .case-row:hover .case-title{ color:var(--paper); }
    .case-row:hover .arrow{ transform:translateX(3px); color:var(--oxblood); }
    .case-id{ font-family:'IBM Plex Mono', monospace; font-size:13px; color:var(--text-muted); }
    .case-date{ font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--text-muted); }
    .case-title{ font-family:'Source Serif 4', serif; font-size:17px; color:var(--text-secondary); transition:color 150ms ease; }
    .arrow{ font-family:'IBM Plex Mono', monospace; color:var(--text-muted); transition:all 150ms ease; }

    @media (max-width:640px){
      .case-row{ grid-template-columns:1fr auto; grid-template-areas:"id date" "title title" "sev sev"; row-gap:8px; }
      .case-id{ grid-area:id; }
      .case-date{ grid-area:date; text-align:right; }
      .case-title{ grid-area:title; }
      .case-row > .badge{ grid-area:sev; justify-self:start; }
    }

    .newsletter{
      background:var(--redact); border-top:1px solid var(--redact-border); border-bottom:1px solid var(--redact-border);
      padding:70px 32px;
    }
    .newsletter-inner{ max-width:640px; margin:0 auto; text-align:left; }
    .newsletter h2{ font-family:'IBM Plex Mono', monospace; font-weight:700; font-size:26px; margin-bottom:10px; }
    .newsletter p{ color:var(--text-secondary); margin-bottom:26px; font-size:16px; }
    .form-row{ display:flex; gap:0; max-width:460px; }
    .form-row input{
      flex:1; background:var(--ink); border:1px solid var(--redact-border); border-right:none;
      color:var(--paper); padding:13px 16px; font-family:'Source Serif 4', serif; font-size:15px;
    }
    .form-row input::placeholder{ color:var(--text-muted); }
    .form-row button{
      background:var(--oxblood); border:1px solid var(--oxblood); color:var(--paper);
      font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:.06em;
      text-transform:uppercase; padding:0 22px; cursor:pointer; transition:background 150ms ease;
    }
    .form-row button:hover{ background:#9C2E3D; }
    .form-note{ font-family:'IBM Plex Mono', monospace; font-size:11px; color:var(--text-muted); margin-top:12px; }
  </style>

  <div class="hero">
    <span class="eyebrow">Vulnerability tracking for RAG systems</span>
    <h1>What's <em>leaking</em><br>from your RAG system?</h1>
    <p>RAGBleed files, dates, and rates vulnerabilities, data leaks, and failure patterns in retrieval-augmented generation systems — as they're found, not as vendors disclose them.</p>
  </div>

  <div class="cases">
    <div class="cases-head">
      <h2>Case Files</h2>
      <span>{sorted.length} filed · 2026</span>
    </div>

    {sorted.map((c) => (
      <a href={`/case/${c.slug}`} class="case-row">
        <span class="case-id">#{c.data.caseId}</span>
        <span class="case-date">{c.data.filedDisplay}</span>
        <span class={`badge ${c.data.severity}`}><span class="badge-dot"></span>{c.data.severity.charAt(0).toUpperCase() + c.data.severity.slice(1)}</span>
        <span class="case-title">{c.data.title}</span>
        <span class="arrow">→</span>
      </a>
    ))}
  </div>

  <div class="newsletter" id="newsletter-section">
    <div class="newsletter-inner">
      <h2>Get the next case file first.</h2>
      <p>One email per finding. No digest, no filler — filed the day it's confirmed.</p>
      <form class="form-row" method="post" action="https://buttondown.com/api/emails/embed-subscribe/ragbleed">
  <input type="email" name="email" placeholder="you@company.com" aria-label="Email address" required>
  <button type="submit">Subscribe</button>
</form>
      <p class="form-note">FILED CASES: {sorted.length} · SUBSCRIBERS SEE THEM FIRST</p>
    </div>
  </div>
</BaseLayout>
